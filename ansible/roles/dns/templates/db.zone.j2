; {{ ansible_managed }}

$TTL {{ dns_ttl }}
@       IN SOA  ns1.{{ dns_zone }}. hostmaster.{{ dns_zone }}. (
                1           ; serial (BIND increments it on every dynamic update)
                3600        ; refresh
                600         ; retry
                1209600     ; expire
                {{ dns_ttl }} )        ; negative caching TTL (how long "does not exist" is remembered)

@       IN NS   ns1.{{ dns_zone }}.
ns1     IN A    {{ dns_server_ip }}
