#cloud-config

hostname: ${hostname}
manage_etc_hosts: true

users:
  - name: ${admin_user}
    groups: [sudo]
    sudo: ALL=(ALL) NOPASSWD:ALL     
    shell: /bin/bash
    lock_passwd: true                
    ssh_authorized_keys:
      - ${ssh_key}

ssh_pwauth: false                    
disable_root: true                   